{
  "name": "chart-quest",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "An interactive game that teaches technical analysis — learn to read any market, one level at a time.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "check:bundle": "node scripts/check-bundle.ts",
    "data:character": "tsx scripts/compute-asset-character.ts",
    "data:fetch": "node scripts/fetch-data.ts",
    "data:rates": "tsx scripts/compute-base-rates.ts",
    "data:resample": "tsx scripts/resample-data.ts",
    "data:sweep": "tsx scripts/compute-edge-sweep.ts",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --quiet",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lightweight-charts": "5.2.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "happy-dom": "20.11.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
